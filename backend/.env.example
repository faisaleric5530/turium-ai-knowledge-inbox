# OpenRouter (answer LLM). Copy this file to .env and fill in the key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pick a current, cheap chat model ID from https://openrouter.ai/models
# Must be a model that GENERATES TEXT via chat/completions (not e.g. perplexity/pplx-decider-*,
# which is a "decisions" model and returns HTTP 400 here).
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Tried in order (comma-separated) when the primary model is rate-limited (HTTP 429) or failing.
# Use models from DIFFERENT providers (the two Gemma models share one Google rate limit).
# Free models are throttled often; set to empty to disable fallback.
LLM_FALLBACK_MODELS=baidu/ernie-5.5-flash-preview:free,google/gemma-4-26b-a4b-it:free

# Embeddings (local, via fastembed)
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_CACHE_DIR=.cache/fastembed

# Storage
DATABASE_PATH=data/inbox.db

# Retrieval
SIMILARITY_THRESHOLD=0.55
TOP_K_DEFAULT=5

# CORS (frontend dev origin)
CORS_ORIGINS=http://localhost:3000

# Logging
# true  = print every write request (POST/PUT/PATCH/DELETE) and its processing steps (ingest stages, retrieval, LLM timing); GET requests are not logged
# false = print only warnings and errors
API_LOGGING=false
LOG_LEVEL=INFO
